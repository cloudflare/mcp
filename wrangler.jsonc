{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cloudflare-api-mcp-dev",
	"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
	"main": "src/index.ts",
	"build": {
		"command": "npm run build:generator"
	},
	"compatibility_date": "2026-01-12",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"issue_detection": {
			"enabled": true
		},
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"CLOUDFLARE_API_BASE": "https://api.cloudflare.com/client/v4",
		"CLOUDFLARE_OAUTH_DOMAIN": "https://dash.cloudflare.com",
		"MCP_RESOURCE": "http://localhost:2529/mcp"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"services": [
		{
			"binding": "GLOBAL_OUTBOUND",
			"service": "cloudflare-api-mcp-dev",
			"entrypoint": "GlobalOutbound"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
		}
	],
	"r2_buckets": [
		{
			"binding": "SPEC_BUCKET",
			"bucket_name": "mcp-spec"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "MCP_METRICS",
			"dataset": "mcp-metrics-dev"
		}
	],
	"containers": [
		{
			"class_name": "ToolsBuilder",
			"scheduling_policy": "durable_object"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TOOLS_BUILDER",
				"class_name": "ToolsBuilder"
			}
		]
	},
	"exports": {
		"ToolsBuilder": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"dev": {
		"port": 2529,
		// The daily build container needs Docker locally; opt in with --enable-containers.
		"enable_containers": false
	},
	"env": {
		"staging": {
			"name": "cloudflare-api-mcp-staging",
			"ai": {
				"binding": "AI"
			},
			"routes": [
				{
					"pattern": "staging.mcp.cloudflare.com",
					"custom_domain": true
				}
			],
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			],
			"services": [
				{
					"binding": "GLOBAL_OUTBOUND",
					"service": "cloudflare-api-mcp-staging",
					"entrypoint": "GlobalOutbound"
				}
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id":"cd658e2801ac4ae6b18082e375f176a3"
				}
			],
			"r2_buckets": [
				{
					"binding": "SPEC_BUCKET",
					"bucket_name": "mcp-spec-staging"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-staging"
				}
			],
			"containers": [
				{
					"class_name": "ToolsBuilder",
					"scheduling_policy": "durable_object"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "TOOLS_BUILDER",
						"class_name": "ToolsBuilder"
					}
				]
			},
			"triggers": {
				"crons": ["0 0 * * *"]
			},
			"vars": {
				"CLOUDFLARE_API_BASE": "https://api.staging.cloudflare.com/client/v4",
				"CLOUDFLARE_OAUTH_DOMAIN": "https://dash.staging.cloudflare.com",
				"MCP_RESOURCE": "https://staging.mcp.cloudflare.com/mcp"
			}
		},
		"production": {
			"name": "cloudflare-api-mcp",
			"ai": {
				"binding": "AI"
			},
			"routes": [
				{
					"pattern": "mcp.cloudflare.com",
					"custom_domain": true
				}
			],
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			],
			"services": [
				{
					"binding": "GLOBAL_OUTBOUND",
					"service": "cloudflare-api-mcp",
					"entrypoint": "GlobalOutbound"
				}
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "c7d4e4f11dfe41e6a22228aa838a14f1"
				}
			],
			"r2_buckets": [
				{
					"binding": "SPEC_BUCKET",
					"bucket_name": "mcp-spec-production"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-production"
				}
			],
			"containers": [
				{
					"class_name": "ToolsBuilder",
					"scheduling_policy": "durable_object"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "TOOLS_BUILDER",
						"class_name": "ToolsBuilder"
					}
				]
			},
			"triggers": {
				"crons": ["0 0 * * *"]
			},
			"vars": {
				"CLOUDFLARE_API_BASE": "https://api.cloudflare.com/client/v4",
				"CLOUDFLARE_OAUTH_DOMAIN": "https://dash.cloudflare.com",
				"MCP_RESOURCE": "https://mcp.cloudflare.com/mcp"
			}
		}
	}
}
