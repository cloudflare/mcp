{
  "name": "cloudflare-mcp",
  "version": "0.1.0",
  "description": "MCP server for the entire Cloudflare API using codemode",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "types": "wrangler types --env-file .env_example",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.attention-ui.json",
    "lint": "oxlint src/",
    "format": "oxfmt --write src/ tests/ scripts/ vitest.config.ts",
    "format:check": "oxfmt --check src/ tests/ scripts/ vitest.config.ts",
    "test": "vitest run",
    "test:events": "vitest run tests/events-e2e.test.ts tests/ans-bridge.test.ts",
    "events:receiver": "node scripts/mcp-events-receiver.mjs",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "seed:staging": "tsx scripts/seed-r2.ts staging",
    "seed:prod": "tsx scripts/seed-r2.ts production",
    "build:attention-panel": "tsx scripts/build-attention-panel.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.13.5",
    "yaml": "^2.9.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@openai/apps-sdk-ui": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^2.14.6",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "workers-oauth-provider-0-10-2": "npm:@cloudflare/workers-oauth-provider@^0.10.2",
    "workers-oauth-provider-1-1-0": "npm:@cloudflare/workers-oauth-provider@^1.1.0",
    "wrangler": "^4.149.0"
  }
}
